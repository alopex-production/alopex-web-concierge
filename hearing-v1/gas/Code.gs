/** Execute setup once, set RECEIVER_SECRET in Script Properties, deploy Web App as owner. */
function setup(){var p=PropertiesService.getScriptProperties();if(!p.getProperty('SPREADSHEET_ID')){var s=SpreadsheetApp.create('ALOPEX｜詳細ヒアリング回答');p.setProperty('SPREADSHEET_ID',s.getId());var t=s.getSheets()[0];t.setName('Answers');t.appendRow(['submission_id','project_id','question_id','question_label','answer_json','note','received_at','schema_version']);t.setFrozenRows(1);t.getRange(1,1,1,8).setBackground('#263a73').setFontColor('#ffffff').setFontWeight('bold');}return p.getProperty('SPREADSHEET_ID');}
function output_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);}
function safe_(x){var s=String(x);return /^[=+\-@\t\r]/.test(s)?"'"+s:s;}
function doPost(e){var lock=LockService.getScriptLock();try{if(!e||!e.postData||e.postData.contents.length>400000)throw Error('invalid_payload');var d=JSON.parse(e.postData.contents),p=PropertiesService.getScriptProperties();if(!p.getProperty('RECEIVER_SECRET')||d.secret!==p.getProperty('RECEIVER_SECRET'))throw Error('unauthorized');delete d.secret;if(d.schemaVersion!==SCHEMA.version||!/^[-a-zA-Z0-9]{8,80}$/.test(d.submissionId)||!/^[-a-zA-Z0-9]{3,80}$/.test(d.projectId)||!Array.isArray(d.answers)||d.answers.length>200)throw Error('invalid_metadata');var map={},seen={};d.answers.forEach(function(x){if(seen[x.questionId])throw Error('duplicate_question');seen[x.questionId]=true;map[x.questionId]=x;});var qs=SCHEMA.questions.filter(function(q){var vals=function(id){var x=map[id];return x?[].concat(x.answer):[]};return (!q.when||vals(q.when[0]).indexOf(q.when[1])>=0)&&(!q.unless||(vals(q.unless[0]).length&&vals(q.unless[0]).indexOf(q.unless[1])<0));});if(qs.length!==d.answers.length)throw Error('question_scope');qs.forEach(function(q){var x=map[q.id];if(!x||typeof x.note!=='string'||x.note.length>2000)throw Error('invalid_answer');var a=x.answer;if(q.type==='multi'){if(!Array.isArray(a)||a.length>q.options.length||new Set(a).size!==a.length)throw Error('invalid_multi');}else if(typeof a!=='string'||a.length>2000)throw Error('invalid_text');if(q.required&&(!a.length||typeof a==='string'&&!a.trim()))throw Error('required');var options=q.type==='design'?['白基調','ダーク','ナチュラル','高級感','シンプル','ポップ']:q.options;if(options.length&&a.length&&![].concat(a).every(function(v){return options.indexOf(v)>=0}))throw Error('invalid_option');if(q.type==='email'&&a&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(a))throw Error('invalid_email');if(q.type==='url'&&a&&!/^https?:\/\/[^\s]+$/.test(a))throw Error('invalid_url');});if(!lock.tryLock(20000))throw Error('busy_retry');var sheet=SpreadsheetApp.openById(p.getProperty('SPREADSHEET_ID')).getSheetByName('Answers');var matches=sheet.getRange('A:A').createTextFinder(d.submissionId).matchEntireCell(true).findAll();if(matches.length){return output_({ok:true,submissionId:d.submissionId,duplicate:true});}var rate=CacheService.getScriptCache(),rateKey=Utilities.base64EncodeWebSafe(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(map.S01Q03.answer)));if(rate.get(rateKey))throw Error('rate_limited_retry_after_60s');var now=new Date().toISOString();var rows=qs.map(function(q){var x=map[q.id];return[d.submissionId,d.projectId,q.id,q.label,safe_(JSON.stringify(x.answer)),safe_(x.note),now,SCHEMA.version]});sheet.getRange(sheet.getLastRow()+1,1,rows.length,8).setValues(rows);SpreadsheetApp.flush();rate.put(rateKey,'1',60);return output_({ok:true,submissionId:d.submissionId});}catch(err){return output_({ok:false,error:String(err.message)});}finally{if(lock.hasLock())lock.releaseLock();}}
