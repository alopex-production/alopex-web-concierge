
function provisionReceiver(){var p=PropertiesService.getScriptProperties();if(!p.getProperty('RECEIVER_SECRET'))p.setProperty('RECEIVER_SECRET',Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,''));console.log('RECEIVER_READY');}
function liveStorageTest(){provisionReceiver();var p=PropertiesService.getScriptProperties(),sheet=SpreadsheetApp.openById(p.getProperty('SPREADSHEET_ID')).getSheetByName('Answers'),a={};SCHEMA.questions.forEach(function(q){a[q.id]=q.type==='multi'?[q.options[0]]:q.type==='design'?'白基調':q.type==='email'?'live-qa-'+Utilities.getUuid().slice(0,8)+'@example.com':q.type==='url'?'https://example.com':q.options.length?q.options[0]:'検収テスト専用';});var qs=SCHEMA.questions.filter(function(q){return(!q.when||[].concat(a[q.when[0]]).indexOf(q.when[1])>=0)&&(!q.unless||(a[q.unless[0]]&&[].concat(a[q.unless[0]]).indexOf(q.unless[1])<0));}),id='QA-'+Utilities.getUuid(),d={secret:p.getProperty('RECEIVER_SECRET'),submissionId:id,projectId:'QA-LIVE-20261113',schemaVersion:SCHEMA.version,answers:qs.map(function(q){return{questionId:q.id,answer:a[q.id],note:q.id==='S01Q01'?'=QA_FORMULA_TEST':'検収テスト（実顧客情報なし）'};})},before=sheet.getLastRow(),send=function(){return JSON.parse(doPost({postData:{contents:JSON.stringify(d)}}).getContent());},first=send(),after=sheet.getLastRow(),second=send(),end=sheet.getLastRow(),rows=sheet.getRange(before+1,1,after-before,8).getValues(),pass=first.ok&&second.ok&&second.duplicate&&after-before===qs.length&&end===after&&rows.every(function(r){return r[0]===id&&r[1]===d.projectId;})&&!sheet.getRange(before+1,6).getFormula();console.log(JSON.stringify({test:'live_google_storage',pass:!!pass,submissionId:id,expectedRows:qs.length,rowsAdded:after-before,rowsAfterRetry:end-after,readBackMatches:rows.length===qs.length,first:first,second:second,formula:sheet.getRange(before+1,6).getFormula()}));if(!pass)throw Error('LIVE_STORAGE_TEST_FAILED');}

