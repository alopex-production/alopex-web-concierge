{
  "name": "alopex-hearing-v2-preview",
  "main": "./worker.mjs",
  "compatibility_date": "2026-11-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory":"./public","binding":"ASSETS","run_worker_first":true},
  "d1_databases": [{"binding":"DB","database_name":"alopex-hearing-v2-preview","database_id":"REPLACE_WITH_NEW_V2_DATABASE_ID"}],
  "vars": {"PUBLIC_ORIGIN":"https://REPLACE_WITH_PRIVATE_PREVIEW_HOST","EMAIL_FROM":"REPLACE_WITH_VERIFIED_SENDER"},
  "triggers": {"crons":["*/5 * * * *"]}
}
